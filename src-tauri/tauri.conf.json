{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "WWKJ WFG100 Betaflight",
    "version": "2026.6.1",
    "identifier": "com.wwkj.wfg100.betaflight",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run tauri:prebuild",
        "devUrl": "http://localhost:8080",
        "frontendDist": "../src/dist"
    },
    "app": {
        "security": {
            "csp": null,
            "capabilities": [
                "default"
            ]
        },
        "windows": [
            {
                "title": "WWKJ WFG100 Betaflight",
                "width": 1024,
                "height": 550,
                "minWidth": 1024,
                "minHeight": 550,
                "resizable": true,
                "fullscreen": false
            }
        ]
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "rpm",
            "appimage",
            "dmg",
            "nsis"
        ],
        "icon": [
            "icons/wwkj_icon_256.png",
            "icons/wwkj_icon.ico"
        ],
        "category": "Utility",
        "copyright": "The Betaflight open source project and WWKJ-FX.",
        "shortDescription": "Configuration and firmware flashing application for Betaflight WFG100 flight controllers.",
        "longDescription": "Cross-platform configuration and management application for Betaflight firmware with WWKJ WFG100 firmware support."
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}
